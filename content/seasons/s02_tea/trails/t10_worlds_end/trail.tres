name_key = "FIND_HORTON_MUSHROOM"
kind = 1
color = Color(0.6, 0.44, 0.3, 1)
appear_chance = 1

[resource]
script = ExtResource("1_trail")
id = &"t10_worlds_end"
name_key = "TRAIL_T10_NAME"
season_id = &"s02_tea"
scene_path = "res://content/seasons/s02_tea/trails/t10_worlds_end/trail.tscn"
length_m = 5000
daylight_seconds = 265.0
par_time = 195.0
weather = ExtResource("2_weather")
ambience = 3
viewpoints = Array[ExtResource("3_vp")]([SubResource("Viewpoint_bakers_falls"), SubResource("Viewpoint_worlds_end")])
unlock_order = 3
finds = Array[ExtResource("9_find")]([SubResource("Find_whistling_thrush_feather"), SubResource("Find_lost_binoculars"), SubResource("Find_rhododendron"), SubResource("Find_sambar_deer"), SubResource("Find_horton_mushroom")])
shortcut_count = 1
