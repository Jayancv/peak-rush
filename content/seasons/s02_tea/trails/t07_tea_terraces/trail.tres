[gd_resource type="Resource" script_class="TrailData" format=3]

[ext_resource type="Script" path="res://data/trail_data.gd" id="1_trail"]
[ext_resource type="Script" path="res://data/find_data.gd" id="9_find"]
[ext_resource type="Script" path="res://data/viewpoint_data.gd" id="3_vp"]
[ext_resource type="Resource" path="res://content/weather/clear.tres" id="2_weather"]
[ext_resource type="Texture2D" path="res://content/seasons/s02_tea/trails/t07_tea_terraces/postcards/tea_pickers.webp" id="pc_tea_pickers"]
[ext_resource type="Texture2D" path="res://content/seasons/s02_tea/trails/t07_tea_terraces/postcards/old_factory.webp" id="pc_old_factory"]

[sub_resource type="Resource" id="Viewpoint_tea_pickers"]
script = ExtResource("3_vp")
id = &"tea_pickers"
name_key = "VP_TEA_PICKERS"
postcard = ExtResource("pc_tea_pickers")

[sub_resource type="Resource" id="Viewpoint_old_factory"]
script = ExtResource("3_vp")
id = &"old_factory"
name_key = "VP_OLD_FACTORY"
postcard = ExtResource("pc_old_factory")

[sub_resource type="Resource" id="Find_purple_orchid"]
script = ExtResource("9_find")
id = &"purple_orchid"
name_key = "FIND_PURPLE_ORCHID"
kind = 0
color = Color(0.62, 0.36, 0.72, 1)
appear_chance = 1

[sub_resource type="Resource" id="Find_tea_bud"]
script = ExtResource("9_find")
id = &"tea_bud"
name_key = "FIND_TEA_BUD"
kind = 0
color = Color(0.62, 0.8, 0.38, 1)
appear_chance = 1

[sub_resource type="Resource" id="Find_pickers_basket"]
script = ExtResource("9_find")
id = &"pickers_basket"
name_key = "FIND_PICKERS_BASKET"
kind = 2
color = Color(0.66, 0.5, 0.3, 1)
appear_chance = 1

[sub_resource type="Resource" id="Find_frangipani"]
script = ExtResource("9_find")
id = &"frangipani"
name_key = "FIND_FRANGIPANI"
kind = 0
color = Color(0.98, 0.93, 0.78, 1)
appear_chance = 1

[sub_resource type="Resource" id="Find_giant_squirrel"]
script = ExtResource("9_find")
id = &"giant_squirrel"
name_key = "FIND_GIANT_SQUIRREL"
kind = 3
color = Color(0.45, 0.25, 0.18, 1)
appear_chance = 0.6

[resource]
script = ExtResource("1_trail")
id = &"t07_tea_terraces"
name_key = "TRAIL_T07_NAME"
season_id = &"s02_tea"
scene_path = "res://content/seasons/s02_tea/trails/t07_tea_terraces/trail.tscn"
length_m = 2700
daylight_seconds = 165.0
par_time = 120.0
weather = ExtResource("2_weather")
ambience = 1
viewpoints = Array[ExtResource("3_vp")]([SubResource("Viewpoint_tea_pickers"), SubResource("Viewpoint_old_factory")])
unlock_order = 0
finds = Array[ExtResource("9_find")]([SubResource("Find_purple_orchid"), SubResource("Find_tea_bud"), SubResource("Find_pickers_basket"), SubResource("Find_frangipani"), SubResource("Find_giant_squirrel")])
