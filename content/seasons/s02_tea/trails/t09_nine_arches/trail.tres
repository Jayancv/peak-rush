[resource]
script = ExtResource("1_trail")
id = &"t09_nine_arches"
name_key = "TRAIL_T09_NAME"
season_id = &"s02_tea"
scene_path = "res://content/seasons/s02_tea/trails/t09_nine_arches/trail.tscn"
length_m = 3900
daylight_seconds = 250.0
par_time = 185.0
weather = ExtResource("2_weather")
ambience = 4
viewpoints = Array[ExtResource("3_vp")]([SubResource("Viewpoint_nine_arches"), SubResource("Viewpoint_jungle_valley")])
unlock_order = 2
finds = Array[ExtResource("9_find")]([SubResource("Find_water_lily"), SubResource("Find_jungle_mushroom"), SubResource("Find_kingfisher_feather"), SubResource("Find_railway_ticket"), SubResource("Find_purple_faced_langur")])
