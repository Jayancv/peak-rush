[ext_resource type="Texture2D" path="res://content/seasons/s02_tea/trails/t09_nine_arches/postcards/jungle_valley.webp" id="pc_jungle_valley"]

[sub_resource type="Resource" id="Viewpoint_nine_arches"]
script = ExtResource("3_vp")
id = &"nine_arches"
name_key = "VP_NINE_ARCHES"
postcard = ExtResource("pc_nine_arches")

[sub_resource type="Resource" id="Viewpoint_jungle_valley"]
script = ExtResource("3_vp")
id = &"jungle_valley"
name_key = "VP_JUNGLE_VALLEY"
postcard = ExtResource("pc_jungle_valley")

[sub_resource type="Resource" id="Find_water_lily"]
script = ExtResource("9_find")
id = &"water_lily"
name_key = "FIND_WATER_LILY"
