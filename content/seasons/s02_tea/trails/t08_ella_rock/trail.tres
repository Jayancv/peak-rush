[resource]
script = ExtResource("1_trail")
id = &"t08_ella_rock"
name_key = "TRAIL_T08_NAME"
season_id = &"s02_tea"
scene_path = "res://content/seasons/s02_tea/trails/t08_ella_rock/trail.tscn"
length_m = 3300
daylight_seconds = 225.0
par_time = 165.0
weather = ExtResource("2_weather")
ambience = 1
viewpoints = Array[ExtResource("3_vp")]([SubResource("Viewpoint_ella_gap"), SubResource("Viewpoint_rock_summit")])
unlock_order = 1
finds = Array[ExtResource("9_find")]([SubResource("Find_tea_flower"), SubResource("Find_toque_macaque"), SubResource("Find_bee_eater_feather"), SubResource("Find_railway_spike"), SubResource("Find_wild_ginger")])
