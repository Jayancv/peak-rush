[sub_resource type="Resource" id="Viewpoint_rock_summit"]
script = ExtResource("3_vp")
id = &"rock_summit"
name_key = "VP_ROCK_SUMMIT"
postcard = ExtResource("pc_rock_summit")

[sub_resource type="Resource" id="Find_tea_flower"]
