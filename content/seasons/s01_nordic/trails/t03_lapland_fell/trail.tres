[gd_resource type="Resource" script_class="TrailData" format=3]

[ext_resource type="Script" path="res://data/trail_data.gd" id="1_trail"]
[ext_resource type="Script" path="res://data/find_data.gd" id="9_find"]
[ext_resource type="Script" path="res://data/viewpoint_data.gd" id="3_vp"]
[ext_resource type="Resource" path="res://content/weather/fog.tres" id="2_weather"]

[sub_resource type="Resource" id="Viewpoint_1"]
script = ExtResource("3_vp")
id = &"reindeer_herd"
name_key = "VP_REINDEER"

[sub_resource type="Resource" id="Viewpoint_2"]
script = ExtResource("3_vp")
id = &"fell_top"
name_key = "VP_FELL_TOP"

[sub_resource type="Resource" id="Find_cloudberry"]
script = ExtResource("9_find")
id = &"cloudberry"
name_key = "FIND_CLOUDBERRY"
kind = 0
color = Color(0.9608, 0.6314, 0.2588, 1)
appear_chance = 1.0

[sub_resource type="Resource" id="Find_birch_bolete"]
script = ExtResource("9_find")
id = &"birch_bolete"
name_key = "FIND_BIRCH_BOLETE"
kind = 1
color = Color(0.5451, 0.3529, 0.1686, 1)
appear_chance = 1.0

[sub_resource type="Resource" id="Find_lost_glove"]
script = ExtResource("9_find")
id = &"lost_glove"
name_key = "FIND_LOST_GLOVE"
kind = 2
color = Color(0.2431, 0.4196, 0.3098, 1)
appear_chance = 1.0

[sub_resource type="Resource" id="Find_arctic_fox_fell"]
script = ExtResource("9_find")
id = &"arctic_fox_fell"
name_key = "FIND_ARCTIC_FOX_FELL"
kind = 3
color = Color(0.8510, 0.8667, 0.8902, 1)
appear_chance = 0.65

[resource]
script = ExtResource("1_trail")
id = &"t03_lapland_fell"
name_key = "TRAIL_T03_NAME"
season_id = &"s01_nordic"
scene_path = "res://content/seasons/s01_nordic/trails/t03_lapland_fell/trail.tscn"
length_m = 2400
daylight_seconds = 160.0
par_time = 115.0
weather = ExtResource("2_weather")
ambience = 3
viewpoints = Array[ExtResource("3_vp")]([SubResource("Viewpoint_1"), SubResource("Viewpoint_2")])
unlock_order = 2
finds = Array[ExtResource("9_find")]([SubResource("Find_cloudberry"), SubResource("Find_birch_bolete"), SubResource("Find_lost_glove"), SubResource("Find_arctic_fox_fell")])
