[gd_resource type="Resource" script_class="TrailData" format=3]

[ext_resource type="Script" path="res://data/trail_data.gd" id="1_trail"]
[ext_resource type="Script" path="res://data/find_data.gd" id="9_find"]
[ext_resource type="Script" path="res://data/viewpoint_data.gd" id="3_vp"]
[ext_resource type="Resource" path="res://content/weather/clear.tres" id="2_weather"]

[sub_resource type="Resource" id="Viewpoint_1"]
script = ExtResource("3_vp")
id = &"lake_mirror"
name_key = "VP_LAKE_MIRROR"
motif = 1

[sub_resource type="Resource" id="Viewpoint_2"]
script = ExtResource("3_vp")
id = &"woodpecker"
name_key = "VP_WOODPECKER"
motif = 2

[sub_resource type="Resource" id="Find_lost_compass"]
script = ExtResource("9_find")
id = &"lost_compass"
name_key = "FIND_LOST_COMPASS"
kind = 2
color = Color(0.5490, 0.3529, 0.1686, 1)
appear_chance = 1.0

[sub_resource type="Resource" id="Find_lingonberry"]
script = ExtResource("9_find")
id = &"lingonberry"
name_key = "FIND_LINGONBERRY"
kind = 0
color = Color(0.9059, 0.6627, 0.7216, 1)
appear_chance = 1.0

[sub_resource type="Resource" id="Find_chanterelle"]
script = ExtResource("9_find")
id = &"chanterelle"
