id = &"red_fox"
name_key = "FIND_RED_FOX"
kind = 3
color = Color(0.7843, 0.3922, 0.1804, 1)
appear_chance = 0.65

[resource]
script = ExtResource("1_trail")
id = &"t01_forest_lake"
name_key = "TRAIL_T01_NAME"
season_id = &"s01_nordic"
scene_path = "res://content/seasons/s01_nordic/trails/t01_forest_lake/trail.tscn"
length_m = 3400
daylight_seconds = 180.0
par_time = 120.0
weather = ExtResource("2_weather")
viewpoints = Array[ExtResource("3_vp")]([SubResource("Viewpoint_1"), SubResource("Viewpoint_2")])
unlock_order = 0
tutorial = true
finds = Array[ExtResource("9_find")]([SubResource("Find_lost_compass"), SubResource("Find_lingonberry"), SubResource("Find_chanterelle"), SubResource("Find_red_fox")])
