[gd_resource type="Resource" script_class="TrailData" format=3]

[ext_resource type="Script" path="res://data/trail_data.gd" id="1_trail"]
[ext_resource type="Script" path="res://data/viewpoint_data.gd" id="3_vp"]
[ext_resource type="Resource" path="res://content/weather/rain.tres" id="2_weather"]

[sub_resource type="Resource" id="Viewpoint_1"]
script = ExtResource("3_vp")
id = &"waterfall"
name_key = "VP_WATERFALL"

[sub_resource type="Resource" id="Viewpoint_2"]
script = ExtResource("3_vp")
id = &"fjord"
name_key = "VP_FJORD"

[resource]
script = ExtResource("1_trail")
id = &"t04_fjord_ridge"
name_key = "TRAIL_T04_NAME"
