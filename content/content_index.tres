[gd_resource type="Resource" script_class="ContentIndex" format=3]

[ext_resource type="Script" path="res://data/content_index.gd" id="1_index"]
[ext_resource type="Script" path="res://data/season_data.gd" id="2_season_script"]
[ext_resource type="Resource" path="res://content/seasons/s01_nordic/season.tres" id="3_s01"]
[ext_resource type="Resource" path="res://content/seasons/s02_tea/season.tres" id="4_s02"]
[ext_resource type="Script" path="res://data/gear_data.gd" id="gear_script"]
[ext_resource type="Resource" path="res://content/gear/grip_boots.tres" id="g_grip_boots"]
[ext_resource type="Resource" path="res://content/gear/hiking_poles.tres" id="g_hiking_poles"]
[ext_resource type="Resource" path="res://content/gear/rain_shell.tres" id="g_rain_shell"]
[ext_resource type="Resource" path="res://content/gear/thermos.tres" id="g_thermos"]
[ext_resource type="Resource" path="res://content/gear/bright_headlamp.tres" id="g_bright_headlamp"]
[ext_resource type="Resource" path="res://content/profile/cosmetics.tres" id="p_cosmetics"]
[ext_resource type="Resource" path="res://content/profile/badges.tres" id="p_badges"]
[ext_resource type="Script" path="res://data/event_data.gd" id="event_script"]
[ext_resource type="Script" path="res://data/journey_data.gd" id="journey_script"]
[ext_resource type="Resource" path="res://content/journeys/kungsleden.tres" id="j_kungsleden"]
[ext_resource type="Resource" path="res://content/events/autumn.tres" id="ev_autumn"]
[ext_resource type="Resource" path="res://content/events/winter_lights.tres" id="ev_winter_lights"]
[ext_resource type="Resource" path="res://content/events/spring_blossom.tres" id="ev_spring_blossom"]
[ext_resource type="Resource" path="res://content/events/midsummer.tres" id="ev_midsummer"]

[resource]
script = ExtResource("1_index")
seasons = Array[ExtResource("2_season_script")]([ExtResource("3_s01"), ExtResource("4_s02")])
gear = Array[ExtResource("gear_script")]([ExtResource("g_grip_boots"), ExtResource("g_hiking_poles"), ExtResource("g_rain_shell"), ExtResource("g_thermos"), ExtResource("g_bright_headlamp")])
cosmetics = ExtResource("p_cosmetics")
badges = ExtResource("p_badges")
events = Array[ExtResource("event_script")]([ExtResource("ev_autumn"), ExtResource("ev_winter_lights"), ExtResource("ev_spring_blossom"), ExtResource("ev_midsummer")])
journeys = Array[ExtResource("journey_script")]([ExtResource("j_kungsleden")])
